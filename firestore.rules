rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for all authenticated users (including anonymous auth)
    match /rooms/{roomId} {
      allow read, write: if request.auth != null;

      match /strokes/{strokeId} {
        allow read, write: if request.auth != null;
      }

      match /presence/{presenceId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
